      "view/title": [
        {
          "command": "codeKit.refreshTools",
          "when": "view == codeKit.views.tools",
          "group": "navigation"
        },
        {
          "command": "codeKit.filterTools",
          "when": "view == codeKit.views.tools",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "codeKit.openNewWindow",
          "when": "view == codeKit.views.tools && viewItem == tool",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "submenu": "codeKit.editor",
          "when": "editorTextFocus && config.codeKit.contextMenuEnabled",
          "group": "codeKit@1"
        }
