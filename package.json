{
  "name": "code-kit-for-vscode",
  "displayName": "CodeKit",
  "description": "A toolkit of handy tools inside VS Code.",
  "version": "0.0.12",
  "publisher": "zhanwangfeng",
  "license": "MIT",
  "icon": "icons/icon-128.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhanwangfeng/CodeKitForVSCode.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "CodeKit",
      "properties": {
        "codeKit.contextMenuEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable the CodeKit editor context menu."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeKit",
          "title": "CodeKit",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "codeKit": [
        {
          "id": "codeKit.views.tools",
          "name": "Tools",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "codeKit.helloWorld",
        "title": "Hello World",
        "category": "CodeKit"
      },
      {
        "command": "codeKit.refreshTools",
        "title": "Refresh Tools",
        "category": "CodeKit",
        "icon": "$(refresh)"
      },
      {
        "command": "codeKit.filterTools",
        "title": "Filter Tools",
        "category": "CodeKit",
        "icon": "$(filter)"
      },
      {
